# Copy to .env.supabase and fill in (this file stays out of git). Used to configure the Vercel deployment.
# Supabase dashboard > Connect: "Transaction pooler" URI (port 6543), with your database password filled in.
DATABASE_URL=
# Supabase dashboard > Connect: "Session pooler" URI (port 5432). Used only for migrations; works over IPv4 on Vercel.
DATABASE_URL_UNPOOLED=
# Supabase dashboard > Project Settings > Storage > S3 Connection
OBJECT_STORAGE_ENDPOINT=https://YOUR-PROJECT-REF.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# The private bucket you created (e.g. documents)
OBJECT_STORAGE_BUCKET=
