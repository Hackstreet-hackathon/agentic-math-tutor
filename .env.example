# --- Core ---
DATABASE_URL="postgresql://mathnb:mathnb@localhost:5432/mathnb?schema=public"
# Used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- File storage ---
# "local" writes to ./storage-data (development). "s3" uses any S3-compatible store.
STORAGE_PROVIDER="local"          # local | s3 | db (db = keep PDFs in Postgres; handy for serverless)
LOCAL_STORAGE_DIR="./storage-data"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# --- AI (all optional; the notebook works without them) ---
LLM_PROVIDER="openai"            # openai | none
OPENAI_API_KEY=""
OPENAI_MODEL=""                  # e.g. gpt-4o, gpt-4o-mini, o3-mini
OPENAI_BASE_URL=""               # leave blank for api.openai.com; set for Azure, LM Studio, etc.

# Tuning (optional — safe to leave blank; defaults shown)
LLM_TIMEOUT_MS=""                # per-request upstream timeout in ms (default 60000)
LLM_MAX_OUTPUT_TOKENS=""         # max tokens in each AI response (default 1800)
AI_RATE_LIMIT_PER_MIN=""         # requests per user per minute (default 20)

# Capability overrides — only needed for unknown/custom models ("true" or "false")
LLM_SUPPORTS_VISION=""           # whether the model accepts image inputs
LLM_SUPPORTS_JSON_SCHEMA=""      # strict JSON schema mode (structured output)
LLM_SUPPORTS_JSON_OBJECT=""      # JSON object mode (looser)
LLM_SUPPORTS_STREAMING=""        # server-sent event streaming

# --- Speech (optional) ---
STT_PROVIDER="none"              # openai (whisper-1) | gradium | none
TTS_PROVIDER="none"              # openai | gradium | none
OPENAI_STT_MODEL=""              # default whisper-1
OPENAI_STT_LANGUAGE=""           # default en
OPENAI_TTS_MODEL=""
OPENAI_TTS_VOICE=""
GRADIUM_API_KEY=""

# --- Math verification service (optional) ---
MATH_SERVICE_URL=""

# Voice conversation: fast model for small talk + maths-or-not triage (maths answers still use LLM_PROVIDER)
FAST_LLM_PROVIDER="openai"       # openai (gpt-4o-mini) | gemini (free) | none
FAST_LLM_MODEL=""                # default: gpt-4o-mini / gemini-2.5-flash-lite
GEMINI_API_KEY=""
OPENAI_TTS_STYLE=""              # e.g. "warm, encouraging maths teacher" (gpt-4o-mini-tts only)
