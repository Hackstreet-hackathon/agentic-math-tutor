# --- Core ---
DATABASE_URL="postgresql://mathnb:mathnb@localhost:5432/mathnb?schema=public"
# Used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- File storage ---
# "local" writes to ./storage-data (development). "s3" uses any S3-compatible store.
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage-data"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# --- AI (all optional; the notebook works without them) ---
LLM_PROVIDER="openai"            # openai | groq | anthropic | none
OPENAI_API_KEY=""
OPENAI_MODEL=""
GROQ_API_KEY=""
GROQ_MODEL=""

# --- Speech (optional) ---
STT_PROVIDER="none"              # groq | gradium | none
TTS_PROVIDER="none"              # openai | gradium | none
OPENAI_TTS_MODEL=""
OPENAI_TTS_VOICE=""
GRADIUM_API_KEY=""

# --- Math verification service (optional) ---
MATH_SERVICE_URL=""
